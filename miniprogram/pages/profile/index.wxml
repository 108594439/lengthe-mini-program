<view class="page profile safe-bottom"><view class="profile-head"><view class="avatar">{{user.avatar}}</view><view><view class="eyebrow">MY LENGTHÉ</view><view class="title">{{user.name}}</view><text>普通会员 · 再消费 ¥720 升级银卡</text></view><text>⚙</text></view><view class="progress card"><view><text>会员成长值</text><text class="b">{{points}} / 1000</text></view><view><view class="i"></view></view></view>
<view class="order card"><view class="order-title"><view class="title">我的预约</view><text bindtap="orders">全部预约　›</text></view><view wx:if="{{order}}" class="order-row"><view class="date"><text>{{order.day.label}}</text><text class="b">{{order.day.date}}</text></view><view><text class="b">{{order.service.name}}</text><text>{{order.store.name}} · {{order.time}}</text></view><text class="em">{{order.status}}</text></view><view wx:else class="empty"><text>还没有预约记录</text><button bindtap="booking">立即预约</button></view></view>
<view class="stats"><view><text class="b">{{order?1:0}}</text><text>预约</text></view><view><text class="b">2</text><text>优惠券</text></view><view><text class="b">{{redemptions.length}}</text><text>兑换</text></view><view><text class="b">{{points}}</text><text>积分</text></view></view>
<view class="mall card"><view class="mall-head"><view><view class="eyebrow">POINT MALL</view><view class="title">积分商城</view></view><text>{{points}} 积分可用</text></view><view class="cloud-note">原型数据继续使用本地缓存；正式上线需接入微信云开发数据库、云函数和事务库存扣减。</view><view wx:for="{{pointGoods}}" wx:key="id" class="gift {{points<item.points||item.stock<=0?'disabled':''}}"><view class="gift-mark">礼</view><view class="gift-main"><view><text class="b">{{item.name}}</text><text wx:if="{{item.stock<=0}}" class="state">库存不足</text><text wx:elif="{{points<item.points}}" class="state">积分不足</text><text wx:else class="state ok">可兑换</text></view><text>{{item.desc}}</text><view><text>{{item.points}} 积分</text><text>库存 {{item.stock}}</text></view></view><button data-id="{{item.id}}" bindtap="redeemGift" disabled="{{points<item.points||item.stock<=0}}">兑换</button></view></view>
<view class="redemption card"><view class="order-title"><view class="title">我的兑换记录</view><text>{{redemptions.length}} 条</text></view><view wx:if="{{!redemptions.length}}" class="empty redemption-empty">暂无兑换记录</view><view wx:for="{{redemptions}}" wx:key="id" class="redeem-row"><view><text class="b">{{item.name}}</text><text>{{item.time}} · {{item.status}}</text></view><text>-{{item.points}}</text></view></view>
<view class="menu card"><view bindtap="booking"><view class="i">约</view><text class="b">立即预约</text><text>›</text></view><button class="contact-menu" open-type="contact"><view class="i">问</view><text class="b">微信客服</text><text>›</text></button><view bindtap="chooseStore"><view class="i">店</view><text class="b">我的常用门店</text><text class="small">{{storeName}}</text><text>›</text></view><view><view class="i">档</view><text class="b">我的接发档案</text><text>›</text></view><view><view class="i">礼</view><text class="b">优惠券与会员权益</text><text>›</text></view></view><view class="foot">一缕青丝 · 一生珍重</view></view>
