<view class="page orders"><view class="eyebrow">MY BOOKINGS</view><view class="title page-title">我的预约</view><view wx:if="{{!orders.length}}" class="empty card">暂无预约记录</view><view wx:for="{{orders}}" wx:key="id" class="order card"><view class="head"><text class="b">{{item.service.name}}</text><text class="em {{item.status==='已取消'?'cancelled':''}}">{{item.status}}</text></view><view class="detail"><text>门店</text><text class="b">{{item.store.name}}</text></view><view class="detail"><text>时间</text><text class="b">{{item.day.date}} {{item.day.label}} · {{item.time}}</text></view><view class="code">预约编号　{{item.id}}</view><view class="buttons"><button data-index="{{index}}" bindtap="rebook">再次预约</button><button wx:if="{{item.status==='待到店'}}" data-index="{{index}}" bindtap="cancel" class="danger">取消预约</button></view></view></view>

