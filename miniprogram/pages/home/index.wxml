<view class="page">
  <view class="top"><view class="logo">髮</view><text class="brand">LENGTHÉ</text><button class="contact" open-type="contact">微信客服</button></view>
  <view class="hero"><view class="seal">髮</view><view class="eyebrow">东方发艺 · 自然新生</view><view class="hero-title title">一缕青丝\n一境东方</view><view class="hero-copy">以东方审美重塑发丝韵律\n定制你的理想长度与发量</view><button class="hero-btn" bindtap="goBooking">立即预约　→</button><view class="ink">山\n水</view></view>
  <view class="store card"><view class="store-cover"><text>三店通约</text><view>青 丝 雅 集</view></view><view class="store-body"><view><text class="hint">温州门店</text><view class="store-name">Lengthé · {{store.name}}</view><text class="address">{{store.address}}</text></view><text class="pin">⌖</text></view><view class="store-meta"><text>◷ 12:00—24:00</text><text>鹿城 · 鳌江 · 苍南</text><text>★ 4.9</text></view></view>
  <view class="section"><view class="section-head"><view><view class="eyebrow">SERVICE</view><view class="section-title title">精选接发项目</view></view><text>查看全部　›</text></view><view class="service" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="goBooking"><view class="service-mark {{item.image?'has-photo':''}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"/><text wx:else>{{item.mark}}</text></view><view class="service-info"><text class="service-name">{{item.name}}</text><text class="service-note">{{item.note}}</text><text class="tag">{{item.tag}}</text></view><view class="price">¥{{item.price}}<text>起</text></view></view></view>
  <view class="promise"><view><text class="b">01</text><text>真发保障</text><text class="small">精选顺滑真人发</text></view><view><text class="b">02</text><text>7天调整</text><text class="small">不满意免费微调</text></view><view><text class="b">03</text><text>专属档案</text><text class="small">记录每次接发方案</text></view></view>
</view>

